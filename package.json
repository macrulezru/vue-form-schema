{
  "name": "@macrulez/vue-form-schema",
  "version": "0.2.3",
  "description": "Reactive Vue 3 forms generated from JSON, Zod, Yup or Valibot schemas, with validation, input masking, conditional UI and SSR support.",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "license": "MIT",
  "homepage": "https://github.com/macrulezru/vue-form-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/vue-form-schema.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/vue-form-schema/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "require": "./dist/zod.cjs"
    },
    "./yup": {
      "types": "./dist/yup.d.ts",
      "import": "./dist/yup.js",
      "require": "./dist/yup.cjs"
    },
    "./valibot": {
      "types": "./dist/valibot.d.ts",
      "import": "./dist/valibot.js",
      "require": "./dist/valibot.cjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "require": "./dist/openapi.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./ui/tailwind": {
      "types": "./dist/ui-tailwind.d.ts",
      "import": "./dist/ui-tailwind.js",
      "require": "./dist/ui-tailwind.cjs"
    },
    "./ui/shadcn": {
      "types": "./dist/ui-shadcn.d.ts",
      "import": "./dist/ui-shadcn.js",
      "require": "./dist/ui-shadcn.cjs"
    },
    "./ui/primevue": {
      "types": "./dist/ui-primevue.d.ts",
      "import": "./dist/ui-primevue.js",
      "require": "./dist/ui-primevue.cjs"
    },
    "./ui/naive": {
      "types": "./dist/ui-naive.d.ts",
      "import": "./dist/ui-naive.js",
      "require": "./dist/ui-naive.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run build",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "demo": "vite --config vite.demo.config.ts",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest --config vitest.config.ts --run",
    "test:coverage": "vitest --config vitest.config.ts --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:nuxt": "npm run build --workspace=packages/nuxt",
    "typecheck:nuxt": "npm run typecheck --workspace=packages/nuxt"
  },
  "keywords": [
    "vue",
    "vue3",
    "form",
    "schema",
    "validation",
    "zod",
    "yup",
    "valibot",
    "json-schema",
    "openapi",
    "mask",
    "ssr",
    "typescript"
  ],
  "peerDependencies": {
    "@vue/devtools-api": "^6 || ^7 || ^8",
    "naive-ui": ">=2.38.0",
    "primevue": ">=4.0.0",
    "valibot": ">=1.0.0",
    "vue": "^3.3.0",
    "yup": ">=1.3.0",
    "zod": ">=3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "primevue": {
      "optional": true
    },
    "naive-ui": {
      "optional": true
    },
    "@vue/devtools-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.58.13",
    "@primeuix/themes": "^3.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vue/devtools-api": "^8.2.1",
    "@vue/language-core": "^3.3.10",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.9.0",
    "naive-ui": "^2.45.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.6",
    "primevue": "^5.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "valibot": "^1.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^1.0.0",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12",
    "yup": "^1.3.0",
    "zod": "^3.22.0"
  }
}
